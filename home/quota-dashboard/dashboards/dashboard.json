{
  "uid": "quota-dashboard",
  "title": "AI Subscription Quotas",
  "tags": [
    "quota",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 28,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "枠",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "使用率とリセット",
      "description": "サービス・枠ごとに使用率、枠の経過率、その差（ペース）、リセットまでと実際のリセット時刻を1行で示す。ペースが正なら時間より速く消費している。6時間以上前の観測しかないホストは除外する。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (service, window, scope) (last_over_time(quota_used_percent[7d]) and on (host_name, service, window, scope) (time() - last_over_time(quota_observed_at_seconds[7d]) < 21600)), \"key\", \"|\", \"service\", \"window\", \"scope\")",
          "legendFormat": "used",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (service, window, scope) (last_over_time(quota_resets_at_seconds[7d]) and on (host_name, service, window, scope) (time() - last_over_time(quota_observed_at_seconds[7d]) < 21600)), \"key\", \"|\", \"service\", \"window\", \"scope\") * 1000",
          "legendFormat": "resets",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (service, window, scope) (last_over_time(quota_resets_at_seconds[7d]) and on (host_name, service, window, scope) (time() - last_over_time(quota_observed_at_seconds[7d]) < 21600)), \"key\", \"|\", \"service\", \"window\", \"scope\") * 1000",
          "legendFormat": "resets_abs",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(time() - max by (service, window, scope) (last_over_time(quota_observed_at_seconds[7d])), \"key\", \"|\", \"service\", \"window\", \"scope\")",
          "legendFormat": "age",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(max by (service, window, scope) (clamp_max(clamp_min((last_over_time(quota_window_seconds[7d]) - (last_over_time(quota_resets_at_seconds[7d]) - time())) / last_over_time(quota_window_seconds[7d]) * 100, 0), 100) and on (host_name, service, window, scope) (time() - last_over_time(quota_observed_at_seconds[7d]) < 21600)), \"key\", \"|\", \"service\", \"window\", \"scope\")",
          "legendFormat": "elapsed",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "key": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "service 2": true,
              "window 2": true,
              "scope 2": true,
              "service 3": true,
              "window 3": true,
              "scope 3": true,
              "service 4": true,
              "window 4": true,
              "scope 4": true,
              "service 5": true,
              "window 5": true,
              "scope 5": true
            },
            "indexByName": {
              "service 1": 0,
              "window 1": 1,
              "scope 1": 2,
              "Value #A": 3,
              "Value #E": 4,
              "Value #B": 5,
              "Value #C": 6,
              "Value #D": 7
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Value #A",
              "operator": "-",
              "right": "Value #E"
            },
            "alias": "Value #PACE",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "service 1": 0,
              "window 1": 1,
              "scope 1": 2,
              "Value #A": 3,
              "Value #E": 4,
              "Value #PACE": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "service 1": "サービス",
              "window 1": "枠",
              "scope 1": "スコープ",
              "Value #A": "使用率",
              "Value #E": "枠の経過",
              "Value #PACE": "ペース",
              "Value #B": "リセットまで",
              "Value #C": "リセット時刻",
              "Value #D": "経過"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "サービス"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "枠"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 65
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "スコープ"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "使用率"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 112
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 95
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "リセットまで"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "リセット時刻"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 132
              },
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "経過"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 900
                    },
                    {
                      "color": "red",
                      "value": 21600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "枠の経過"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ペース"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.align",
                "value": "right"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "サービス",
            "desc": false
          },
          {
            "displayName": "枠",
            "desc": false
          },
          {
            "displayName": "スコープ",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "推移",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "週枠の使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 3600000
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, scope) (quota_used_percent{window=\"weekly\"})",
          "legendFormat": "{{service}} {{scope}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5時間枠の使用率",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": 3600000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (quota_used_percent{window=\"5h\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "健全性",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "取得エラー (1時間あたり)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(collector_errors_total[1h])) or vector(0)",
          "legendFormat": "errors"
        }
      ]
    }
  ]
}
